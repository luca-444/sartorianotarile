---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Sections from '../components/Sections.astro';
import Footer from '../components/Footer.astro';
import zone from '../data/zone.json';

export function getStaticPaths() {
  return zone.map((z) => ({ params: { zona: z.slug }, props: { z } }));
}

const { z } = Astro.props;
const primi = z.comuni.slice(0, 4).join(', ');
const title = `Servizi per studi notarili in provincia di ${z.nome} — back office, segreteria esternalizzata e IT in ${z.regione} | Sartoria Notarile`;
const description = `Supporto operativo per studi notarili nella ${z.provincia} e in ${z.regione}: presa in carico delle richieste, preventivi, raccolta documentale, solleciti, fascicoli istruiti e bozze. E assistenza IT, cloud e cybersecurity. Attivi a ${primi} e in tutta la provincia.`;

const ld = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  "name": `Sartoria Notarile — ${z.provincia}`,
  "url": `https://www.sartorianotarile.it/${z.slug}/`,
  "description": description,
  "parentOrganization": { "@type": "Organization", "name": "Giamor Group S.r.l." },
  "areaServed": [z.nome, z.provincia, z.regione, ...z.comuni],
  "email": "info@sartorianotarile.it",
  "telephone": "+393884079916"
};
---
<Base title={title} description={description} canonical={`/${z.slug}/`}>
  <script type="application/ld+json" is:inline slot="head" set:html={JSON.stringify(ld)}></script>

  <Nav />

  <header class="hero">
    <div class="hero-in" style="padding-bottom:34px">
      <p class="kicker">Studi notarili &middot; {z.provincia} &middot; {z.regione}</p>
      <h1>Studi notarili di {z.nome}:<br>voi ricevete i clienti, <em>a tutto il resto pensiamo noi.</em></h1>
      <p class="hero-sub">Richieste inquadrate, preventivi pronti, documenti raccolti: clienti, agenzie, amministratori, tecnici e banche li sentiamo noi. Lo studio riceve una sola notifica: &laquo;completo&raquo;. Pi&ugrave; la gestione completa di IT, cloud e cybersecurity, tutto da remoto.</p>
    </div>
    <div class="hero-cta-row">
      <a class="btn btn-bronze" href="#comuni">Fai l'upgrade del tuo studio</a>
      <a class="btn btn-paper" href="#backoffice">Scopri cosa delegare</a>
    </div>
    <div class="doors">
      <article class="door reveal">
        <p class="tag">Il territorio</p>
        <h2>Un partner per gli studi di {z.nome}</h2>
        <p>{z.intro}</p>
        <p style="margin-top:12px; font-size:13.5px; color:var(--bronze-l)">Riferimento territoriale: {z.distretto}</p>
      </article>
      <article class="door reveal">
        <p class="tag">Come lavoriamo</p>
        <h2>Dentro il vostro processo, fuori dallo studio</h2>
        <p>Ci inseriamo nel flusso di lavoro senza cambiarlo: prendiamo in carico le richieste, dialoghiamo con clienti e interlocutori a nome dello studio, raccogliamo e verifichiamo i documenti su canale sicuro. Nessun software da installare, NDA su ogni pratica e nomina GDPR come responsabile del trattamento.</p>
      </article>
    </div>
  </header>

  <!-- ============ COMUNI SERVITI ============ -->
  <section id="comuni" style="background:var(--linen)" aria-labelledby="comuni-title">
    <div class="wrap">
      <div class="sec-head reveal">
        <p class="kicker">Dove operiamo nella {z.provincia}</p>
        <h2 class="sec-title" id="comuni-title">Hai uno studio notarile in uno di questi comuni?</h2>
        <p>Serviamo gli studi notarili di tutta la {z.provincia}, da remoto e senza vincoli di distanza. Se il tuo studio ha sede in uno di questi comuni, il servizio &egrave; attivabile entro una settimana.</p>
      </div>
      <ul class="comuni-grid reveal">
        {z.comuni.map((c) => (<li>{c}</li>))}
      </ul>
      <div class="upgrade reveal">
        <p class="up-title">Fai l'upgrade del tuo studio.</p>
        <p class="up-text">Ore restituite ogni settimana, meno errori, costi certi per attivit&agrave;: 20 minuti di confronto bastano per capire da quali attivit&agrave; conviene partire. Nessuna vendita, nessun impegno.</p>
        <div class="hero-cta" style="margin-bottom:0; justify-content:flex-start">
          <a class="btn btn-bronze" href={`mailto:info@sartorianotarile.it?subject=Upgrade%20studio%20notarile%20%E2%80%94%20${z.nome}`}>Richiedi un incontro</a>
          <a class="btn btn-ghost" href="#pilota">Come funziona il pilota</a>
        </div>
      </div>
    </div>
  </section>

  <Sections />

  <!-- ============ CTA PROVINCIA ============ -->
  <section class="cta-band" id="contatti" aria-labelledby="cta-local">
    <h2 id="cta-local">Studi notarili di {z.nome}:<br><span>quali attivit&agrave; affideresti per prime?</span></h2>
    <p>Venti minuti nel tuo studio o in videochiamata, nessuna vendita: presentiamo il progetto, ascoltiamo la prassi dello studio e — se ti convince — il pilota si attiva entro una settimana.</p>
    <div class="hero-cta" style="margin-bottom:0">
      <a class="btn btn-bronze" href={`mailto:info@sartorianotarile.it?subject=Richiesta%20incontro%20%E2%80%94%20${z.nome}`}>Richiedi un incontro</a>
      <a class="btn btn-paper" href={`mailto:info@sartorianotarile.it?subject=Check-up%20GDPR%20gratuito%20%E2%80%94%20${z.nome}`}>Check-up GDPR gratuito</a>
    </div>
    <div class="contact-card">
      <a href="tel:+393884079916">
        <span class="lbl">Telefono</span>
        <span class="val">+39 388 407 9916</span>
      </a>
      <a href="mailto:info@sartorianotarile.it">
        <span class="lbl">Email</span>
        <span class="val">info@sartorianotarile.it</span>
      </a>
    </div>
  </section>

  <Footer />
</Base>
