---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Sections from '../components/Sections.astro';
import Footer from '../components/Footer.astro';
const title = "Sartoria Notarile — Back office notarile e partner IT per studi notarili";
const description = "Sartoria Notarile: back office giuridico in outsourcing e assistenza informatica per studi notarili. Fascicoli istruiti, bozze di atti, visure interpretate — e un unico partner IT per infrastruttura, cloud, cybersecurity e GDPR. Tempo liberato, costi certi.";
const ldService = {"@context": "https://schema.org", "@type": "ProfessionalService", "name": "Sartoria Notarile", "url": "https://www.sartorianotarile.it/", "description": "Back office giuridico in outsourcing e servizi IT gestiti (MSP) per studi notarili: fascicoli istruiti, bozze di atti, visure, adempimenti — e infrastruttura, cloud, cybersecurity, GDPR.", "parentOrganization": {"@type": "Organization", "name": "Giamor Group S.r.l."}, "areaServed": ["Emilia-Romagna", "Veneto", "Ravenna", "Bologna", "Forlì-Cesena", "Rimini", "Ferrara", "Modena", "Rovigo", "Italia"], "knowsAbout": ["back office notarile", "outsourcing pratiche notarili", "assistenza informatica studi notarili", "cybersecurity", "GDPR"], "email": "info@sartorianotarile.it", "telephone": "+393884079916"};
const ldFaq = {"@context": "https://schema.org", "@type": "FAQPage", "mainEntity": [{"@type": "Question", "name": "Il mio studio deve installare un software?", "acceptedAnswer": {"@type": "Answer", "text": "No. Nessuna installazione, nessuna integrazione, nessuna formazione: lo studio condivide documenti e istruzioni via mail o cartella sicura Microsoft 365 e scarica il lavoro finito."}}, {"@type": "Question", "name": "Chi lavora sulle pratiche del mio studio?", "acceptedAnswer": {"@type": "Answer", "text": "Giuristi qualificati e formati sulla prassi notarile, potenziati da un'AI documentale verticale. Ogni consegna passa un doppio controllo, umano e sistemico, prima di arrivare allo studio."}}, {"@type": "Question", "name": "Come viene garantita la riservatezza degli atti?", "acceptedAnswer": {"@type": "Answer", "text": "Tutto il ciclo di lavorazione avviene su infrastruttura Microsoft 365 con dati cifrati e data center UE, NDA su ogni pratica, nomina GDPR come responsabile del trattamento (art. 28) e segregazione dei dati per singolo studio."}}, {"@type": "Question", "name": "Quali sono i tempi di consegna?", "acceptedAnswer": {"@type": "Answer", "text": "Pratiche standard entro 2 giornate lavorative, pratiche complesse in 3–4 giornate, urgenze gestite ad hoc entro 12 ore."}}, {"@type": "Question", "name": "Che cos'è il progetto pilota?", "acceptedAnswer": {"@type": "Answer", "text": "Un test di 4–6 settimane su pratiche reali: lo studio sceglie 2–3 attività, noi le eseguiamo misurando tempi e qualità, e alla fine lo studio riceve una proposta di prezzo certo per ogni attività — il suo primo listino interno. Gli studi pilota hanno condizioni riservate."}}]};
---
<Base title={title} description={description} canonical="/">
  <script type="application/ld+json" is:inline slot="head" set:html={JSON.stringify(ldService)}></script>
  <script type="application/ld+json" is:inline slot="head" set:html={JSON.stringify(ldFaq)}></script>
<Nav />
<header class="hero" id="top">
  <div class="hero-in">
    <p class="kicker">Un unico partner per lo studio notarile</p>
    <h1>Il back office giuridico<br>e il partner&nbsp;IT <em>dello studio notarile.</em></h1>
    <p class="hero-sub">Da un lato liberiamo tempo allo studio con l'outsourcing delle pratiche notarili: fascicoli istruiti, controlli, bozze pronte per il controllo del Notaio. Dall'altro gestiamo tutta la tecnologia: infrastruttura, cloud, cybersecurity, GDPR.</p>
  </div>
  <div class="hero-cta-row">
    <a class="btn btn-bronze" href="#pilota">Scopri il progetto pilota</a>
    <a class="btn btn-paper" href="#it-cyber">Servizi IT per lo studio</a>
  </div>
  <div class="doors">
    <article class="door reveal">
      <p class="tag">Back office notarile</p>
      <h2>Tempo restituito a chi firma</h2>
      <p>Giuristi qualificati e AI documentale verticale assorbono il lavoro ripetitivo dello studio: istruttoria delle pratiche, controlli documentali, visure interpretate, bozze di atti sullo stile dello studio. Lo studio carica il materiale grezzo e scarica il lavoro finito.</p>
      <a class="btn btn-ghost" href="#backoffice">Scopri cosa delegare</a>
    </article>
    <article class="door reveal">
      <p class="tag">IT, cloud &amp; cybersecurity</p>
      <h2>Un solo fornitore per tutta la tecnologia</h2>
      <p>Reti, server, backup, Microsoft 365, protezione dai cyber-attacchi e adeguamento GDPR: pacchetti studiati per gli studi notarili, con la sicurezza dei dati e la continuit&agrave; operativa come priorit&agrave; assolute.</p>
      <a class="btn btn-ghost" href="#it-cyber">Scopri i servizi IT</a>
    </article>
  </div>
</header>

<Sections />
<!-- ================= CTA ================= -->
<section class="cta-band" id="contatti" aria-labelledby="cta-title">
  <h2 id="cta-title">Quali attivit&agrave; affideresti per prime?<br><span>Scegliamole insieme.</span></h2>
  <p>Venti minuti nel tuo studio, nessuna vendita: presentiamo il progetto, ascoltiamo la prassi dello studio e — se ti convince — il pilota si attiva entro una settimana.</p>
  <div class="hero-cta" style="margin-bottom:0">
    <a class="btn btn-bronze" href="mailto:info@sartorianotarile.it?subject=Richiesta%20incontro%20%E2%80%94%20Sartoria%20Notarile">Richiedi un incontro</a>
    <a class="btn btn-paper" href="mailto:info@sartorianotarile.it?subject=Check-up%20GDPR%20gratuito">Check-up GDPR gratuito</a>
  </div>
  <div class="contact-card">
    <a href="tel:+393884079916">
      <span class="lbl">Telefono</span>
      <span class="val">+39 388 407 9916</span>
    </a>
    <a href="mailto:info@sartorianotarile.it">
      <span class="lbl">Email</span>
      <span class="val">info@sartorianotarile.it</span>
    </a>
  </div>
</section>

<Footer />
</Base>
