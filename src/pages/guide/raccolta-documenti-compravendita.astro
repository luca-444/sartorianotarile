const description = "Checklist operativa dei documenti per una compravendita immobiliare: cosa serve per le parti, per l'immobile, per i casi particolari, chi contattare per ottenere ciascun documento e gli errori che fanno slittare la stipula.";

const ldArticle = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": "Raccolta documenti per la compravendita: checklist operativa per studi notarili",
  "description": description,
  "author": { "@type": "Organization", "name": "Servizi Studi Notarili — Giamor Group S.r.l." },
  "publisher": { "@type": "Organization", "name": "Giamor Group S.r.l." },
  "inLanguage": "it-IT"
};
const ldFaq = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    { "@type": "Question", "name": "Chi contattare per ottenere i documenti di una compravendita?",
      "acceptedAnswer": { "@type": "Answer", "text": "Gli interlocutori tipici sono cinque: il cliente per i documenti personali e l'atto di provenienza, l'amministratore di condominio per la dichiarazione sulle spese e i verbali, il tecnico per la conformità urbanistica e catastale e l'APE, l'agenzia immobiliare per proposta e preliminare, la banca per la documentazione del mutuo e per l'eventuale cancellazione di ipoteca." } },
    { "@type": "Question", "name": "Quali sono i documenti che più spesso fanno slittare una stipula?",
      "acceptedAnswer": { "@type": "Answer", "text": "Nell'esperienza degli studi i ritardi più frequenti derivano da: dichiarazione dell'amministratore di condominio, documentazione urbanistica e conformità catastale, atto di provenienza nei casi di successione, documenti di identità scaduti e assenso alla cancellazione dell'ipoteca da parte della banca." } },
    { "@type": "Question", "name": "Come si organizza la raccolta documentale per ridurre i tempi?",
      "acceptedAnswer": { "@type": "Answer", "text": "Con tre accorgimenti: inviare al cliente un elenco unico e completo al primo contatto anziché richieste successive, aprire in parallelo i canali verso amministratore, tecnico e banca senza attendere il cliente, e fissare la data di stipula solo quando il fascicolo è completo, non prima." } }
  ]
