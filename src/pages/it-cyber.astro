---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Cta from '../components/Cta.astro';
import Footer from '../components/Footer.astro';
const title = "IT, cloud e cybersecurity per studi notarili — un unico partner tecnologico | Sartoria Notarile";
const description = "Servizi IT gestiti per studi notarili: reti, server, backup e continuità operativa, Microsoft 365, protezione da ransomware e attacchi informatici, adeguamento GDPR, firma digitale e strumenti telematici. Un solo fornitore, canoni chiari.";
const ldService = {
  "@context":"https://schema.org","@type":"Service",
  "name":"Servizi IT gestiti per studi notarili",
  "serviceType":"Assistenza informatica, cloud e cybersecurity per studi notarili",
  "description": description,
  "provider":{"@type":"Organization","name":"Giamor Group S.r.l.","vatID":"02823670399","telephone":"+393884079916"},
  "areaServed":{"@type":"Country","name":"Italia"},
  "audience":{"@type":"Audience","audienceType":"Studi notarili"}
};
---
<Base title={title} description={description} canonical="/it-cyber/">
  <script type="application/ld+json" is:inline slot="head" set:html={JSON.stringify(ldService)}></script>
  <Nav />
  <header class="hero">
    <div class="hero-in" style="padding-bottom:60px">
      <p class="kicker">IT, cloud &amp; cybersecurity per studi notarili</p>
      <h1>Un unico partner tecnologico<br><em>per tutto lo studio.</em></h1>
      <p class="hero-sub">Reti, server, backup, Microsoft&nbsp;365, protezione dai cyber-attacchi e adeguamento GDPR: una sola responsabilit&agrave;, un solo referente, nessuno scaricabarile tra fornitori diversi.</p>
    </div>
  </header>
<!-- ================= IT & CYBER (MSP) ================= -->
<section id="it-cyber" class="dark">
  <div class="wrap">
    <div class="sec-head reveal">
      <p class="kicker">Perch&eacute; conta per uno studio notarile</p>
      <h2 class="sec-title" id="it-title">I dati pi&ugrave; sensibili che esistano</h2>
      <p>Atti, patrimoni, identit&agrave;: uno studio notarile custodisce informazioni che non possono essere perse n&eacute; violate. Gestiamo l'intera tecnologia dello studio con pacchetti costruiti sulla sua dimensione reale.</p>
    </div>
    <div class="banner reveal">
      <img src="/img/cybersecurity-studio-notarile.webp" alt="Cybersecurity e protezione dei dati per studi notarili: server sicuri, backup cifrati, difesa da attacchi informatici" width="999" height="583" loading="lazy">
    </div>
    <div class="grid3">
      <div class="card reveal"><div class="ic"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 13c0 5-3.5 7.5-7.7 8.9a.7.7 0 0 1-.6 0C7.5 20.5 4 18 4 13V6.3a1 1 0 0 1 .7-1L11.7 3a1 1 0 0 1 .6 0l7 2.4a1 1 0 0 1 .7.9Z"/><path d="m9 12 2 2 4-4"/></svg></div><h3>Cybersecurity</h3><p>Protezione da ransomware e attacchi informatici, monitoraggio continuo, formazione anti-phishing per i collaboratori: la difesa del segreto professionale &egrave; la nostra priorit&agrave; assoluta.</p></div>
      <div class="card reveal"><div class="ic"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><ellipse cx="12" cy="5" rx="8" ry="3"/><path d="M4 5v14c0 1.7 3.6 3 8 3s8-1.3 8-3V5"/><path d="M4 12c0 1.7 3.6 3 8 3s8-1.3 8-3"/></svg></div><h3>Backup e continuit&agrave; operativa</h3><p>Copie di sicurezza cifrate e verificate, piani di disaster recovery: lo studio non si ferma mai, nemmeno davanti a un guasto o a un attacco.</p></div>
      <div class="card reveal"><div class="ic"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v18"/><path d="M8 21h8"/><path d="M4 7h16"/><path d="m7 7-3 7a3.2 3.2 0 0 0 6 0Z"/><path d="m17 7-3 7a3.2 3.2 0 0 0 6 0Z"/></svg></div><h3>Adeguamento GDPR</h3><p>Misure di sicurezza, registri dei trattamenti, gestione dei data breach: la conformit&agrave; &egrave; un obbligo dello studio prima ancora che dei suoi fornitori. Ci pensiamo noi.</p></div>
      <div class="card reveal"><div class="ic"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17.5 19H9a7 7 0 1 1 6.7-9h1.8a4.5 4.5 0 1 1 0 9Z"/></svg></div><h3>Cloud e Microsoft 365</h3><p>Posta elettronica sicura, condivisione documenti, lavoro da remoto protetto: l'ambiente Microsoft 365 configurato e gestito per le esigenze di uno studio notarile.</p></div>
      <div class="card reveal"><div class="ic"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="7" rx="1.5"/><rect x="3" y="14" width="18" height="7" rx="1.5"/><path d="M7 6.5h.01M7 17.5h.01"/></svg></div><h3>Reti, server e postazioni</h3><p>Infrastruttura sempre efficiente: assistenza proattiva su computer, server e reti, interventi rapidi, aggiornamenti gestiti. I problemi si prevengono, non si rincorrono.</p></div>
      <div class="card reveal"><div class="ic"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="8" cy="16" r="4"/><path d="m11 13 8.5-8.5"/><path d="M16.5 7.5 19 10"/><path d="m14 10 2 2"/></svg></div><h3>Firma digitale e strumenti telematici</h3><p>Supporto completo su firma digitale, PEC, dispositivi e piattaforme telematiche: gli strumenti del notariato digitale, sempre funzionanti.</p></div>
    </div>
    <div class="levers">
      <div class="lever reveal"><div class="dot" aria-hidden="true"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12 5 5L19 7"/></svg></div><div><h4>Protezione del segreto professionale</h4><p>Dati cifrati, accessi tracciati, data center nell'Unione Europea: la riservatezza degli atti trattata come un dovere, non come un'opzione.</p></div></div>
      <div class="lever reveal"><div class="dot" aria-hidden="true"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12 5 5L19 7"/></svg></div><div><h4>Zero fermi di studio</h4><p>Ogni ora di fermo &egrave; una stipula rinviata. Monitoraggio proattivo e intervento rapido per una continuit&agrave; operativa reale.</p></div></div>
      <div class="lever reveal"><div class="dot" aria-hidden="true"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12 5 5L19 7"/></svg></div><div><h4>Pacchetti ad hoc, costi prevedibili</h4><p>Canoni chiari costruiti sulla dimensione dello studio: niente sorprese, niente interventi a chiamata dal costo ignoto.</p></div></div>
      <div class="lever reveal"><div class="dot" aria-hidden="true"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12 5 5L19 7"/></svg></div><div><h4>Un solo referente</h4><p>Rete, cloud, sicurezza, gestionali: quando tutto &egrave; di un unico partner, la responsabilit&agrave; non si scarica mai su &laquo;l'altro fornitore&raquo;.</p></div></div>
    </div>
    <div class="statement reveal" style="text-align:center">
      <strong>Check-up gratuito di sicurezza e conformit&agrave; GDPR:</strong> mezz'ora di un nostro tecnico, un report completo, zero impegno. <a href="#contatti" style="color:var(--bronze-l); font-weight:700">Richiedilo per il tuo studio &rarr;</a>
    </div>
  </div>
</section>


  <Cta titolo="Check-up gratuito di sicurezza e conformità GDPR" testo="Mezz'ora di un nostro tecnico nello studio, un report completo, zero impegno. Molti studi scoprono di essere più esposti di quanto credessero." />
  <Footer />
</Base>
