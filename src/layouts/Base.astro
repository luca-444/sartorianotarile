---
const {
  title,
  description,
  canonical = Astro.url.pathname,
} = Astro.props;
const canonicalURL = new URL(canonical, Astro.site);
---
<!DOCTYPE html>
<html lang="it">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{title}</title>
<meta name="description" content={description}>
<link rel="canonical" href={canonicalURL}>
<meta property="og:type" content="website">
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:url" content={canonicalURL}>
<meta property="og:locale" content="it_IT">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&family=Source+Sans+3:ital,wght@0,400;0,600;0,700;1,400&display=swap" rel="stylesheet">
<slot name="head" />
<style is:global>

  :root{
    --ink:#26221E; --ink2:#3B352E; --bronze:#9A7B4F; --bronze-l:#C4A876;
    --paper:#FFFFFF; --linen:#F6F3EE; --mute:#766E63; --hair:#E4DDD2;
    --dark-hair:#4A4238; --dark-text:#D8D2C8; --dark-mute:#B8B0A4;
    --serif:'Cormorant Garamond', Georgia, serif;
    --sans:'Source Sans 3', 'Segoe UI', sans-serif;
    --maxw:1160px;
  }
  *{margin:0;padding:0;box-sizing:border-box}
  html{scroll-behavior:smooth}
  @media (prefers-reduced-motion: reduce){ html{scroll-behavior:auto} .reveal{opacity:1 !important; transform:none !important; transition:none !important} }
  body{font-family:var(--sans); color:var(--ink2); background:var(--paper); font-size:17px; line-height:1.6; -webkit-font-smoothing:antialiased}
  img{max-width:100%}
  a{color:var(--bronze)}
  a:focus-visible, button:focus-visible{outline:2px solid var(--bronze); outline-offset:3px}
  .wrap{max-width:var(--maxw); margin:0 auto; padding:0 24px}

  /* ---------- signature: la cucitura ---------- */

  /* ---------- nav ---------- */
  nav{position:sticky; top:0; z-index:50; background:rgba(255,255,255,.94); backdrop-filter:blur(8px); border-bottom:1px solid var(--hair)}
  .nav-in{display:flex; align-items:center; justify-content:space-between; height:66px}
  .logo{display:flex; align-items:center; gap:10px; text-decoration:none}
  .logo .mark{color:var(--bronze); display:inline-flex; align-items:center; align-self:center}
  footer .brand svg{color:var(--bronze); vertical-align:-2px}
  .logo .word{font-family:var(--serif); font-weight:600; font-size:20px; letter-spacing:.14em; color:var(--ink); text-transform:uppercase}
  .nav-links{display:flex; gap:26px; align-items:center}
  .nav-links a{font-size:13.5px; font-weight:600; letter-spacing:.06em; text-transform:uppercase; color:var(--ink2); text-decoration:none}
  .nav-links a:hover{color:var(--bronze)}
  .btn{display:inline-block; font-family:var(--sans); font-weight:700; font-size:14px; letter-spacing:.05em; text-transform:uppercase; text-decoration:none; padding:13px 26px; border-radius:3px; transition:background .2s,color .2s,border-color .2s; cursor:pointer; border:1px solid transparent}
  .btn-bronze{background:var(--bronze); color:#fff}
  .btn-bronze:hover{background:#7f6540}
  .btn-ghost{border-color:var(--bronze); color:var(--bronze); background:transparent}
  .btn-ghost:hover{background:var(--bronze); color:#fff}
  .btn-paper{background:var(--paper); color:var(--ink)}
  .btn-paper:hover{background:var(--linen)}
  

  /* ---------- hero ---------- */
  header.hero{background:var(--ink); color:var(--paper); position:relative; overflow:hidden}
  .hero-in{padding:84px 24px 0; text-align:center; max-width:920px; margin:0 auto}
  .kicker{font-size:12.5px; font-weight:700; letter-spacing:.32em; text-transform:uppercase; color:var(--bronze-l)}
  h1{font-family:var(--serif); font-weight:600; font-size:clamp(34px,5.2vw,58px); line-height:1.12; color:var(--paper); margin:22px 0 18px}
  h1 em{font-style:italic; color:var(--bronze-l)}
  .hero-sub{font-size:18.5px; color:var(--dark-mute); max-width:640px; margin:0 auto 42px}
  .hero-cta{display:flex; gap:14px; justify-content:center; flex-wrap:wrap; margin-bottom:64px}

  .hero-cta-row{display:grid; grid-template-columns:1fr 1fr; gap:28px; max-width:var(--maxw); margin:0 auto; padding:0 24px 30px}
  .hero-cta-row .btn{display:block; width:100%; text-align:center; padding:16px 26px}
  @media(max-width:760px){ .hero-cta-row{grid-template-columns:1fr; gap:14px} }
  /* dual doors */
  .doors{display:grid; grid-template-columns:1fr 1fr; gap:28px; max-width:var(--maxw); margin:0 auto; padding:0 24px 74px; align-items:stretch}
  .door{background:#2F2A24; border:1px solid var(--dark-hair); border-radius:6px; padding:34px 30px; text-align:left; display:flex; flex-direction:column; transition:border-color .25s, transform .25s}
  .door:hover{border-color:var(--bronze); transform:translateY(-3px)}
  .door .tag{font-size:11.5px; font-weight:700; letter-spacing:.26em; text-transform:uppercase; color:var(--bronze-l); margin-bottom:14px}
  .door h2{font-family:var(--serif); font-weight:600; font-size:27px; color:var(--paper); margin-bottom:12px; line-height:1.2}
  .door p{font-size:15.5px; color:var(--dark-text); flex:1}
  .door a{margin-top:22px; align-self:flex-start}
  @media(max-width:760px){ .doors{grid-template-columns:1fr; gap:22px} }

  /* ---------- sections ---------- */
  section{padding:88px 0}
  .sec-head{text-align:center; max-width:780px; margin:0 auto 54px}
  .sec-head .kicker{color:var(--bronze)}
  h2.sec-title{font-family:var(--serif); font-weight:600; font-size:clamp(28px,3.6vw,40px); color:var(--ink); line-height:1.15; margin:16px 0 14px}
  .sec-head p{color:var(--mute); font-size:17px}
  .dark{background:var(--ink); color:var(--dark-text)}
  .dark h2.sec-title{color:var(--paper)}
  .dark .sec-head p{color:var(--dark-mute)}
  .dark .kicker{color:var(--bronze-l)}

  .grid3{display:grid; grid-template-columns:repeat(3,1fr); gap:22px}
  .grid2{display:grid; grid-template-columns:repeat(2,1fr); gap:22px}
  @media(max-width:900px){ .grid3{grid-template-columns:1fr 1fr} }
  @media(max-width:640px){ .grid3,.grid2{grid-template-columns:1fr} }

  .card{background:var(--linen); border:1px solid var(--hair); border-radius:6px; padding:28px 26px}
  .card h3{font-family:var(--serif); font-weight:700; font-size:20.5px; color:var(--ink); margin:14px 0 8px; line-height:1.25}
  .card p{font-size:14.8px; color:var(--ink2)}
  .card .ic{width:46px; height:46px; border:1.5px solid var(--bronze); border-radius:50%; display:flex; align-items:center; justify-content:center; font-size:20px; color:var(--bronze)}
  .dark .card{background:#2F2A24; border-color:var(--dark-hair)}
  .dark .card h3{color:var(--paper)}
  .dark .card p{color:var(--dark-text)}

  .statement{background:var(--ink); border:1px solid var(--bronze); border-radius:6px; color:var(--dark-text); padding:30px 34px; margin-top:40px; font-size:16.5px; line-height:1.65}
  .statement strong{color:var(--paper)}
  .statement .gold{color:var(--bronze-l); font-weight:700}
  .dark .statement{background:#2F2A24}

  /* steps */
  .steps{display:grid; grid-template-columns:repeat(4,1fr); gap:22px; counter-reset:step}
  @media(max-width:900px){ .steps{grid-template-columns:1fr 1fr} }
  @media(max-width:560px){ .steps{grid-template-columns:1fr} }
  .step{position:relative; padding:26px 24px; background:var(--paper); border:1px solid var(--hair); border-radius:6px}
  .step::before{counter-increment:step; content:counter(step,decimal-leading-zero); font-family:var(--serif); font-size:34px; font-weight:600; color:var(--bronze-l); display:block; margin-bottom:8px}
  .step h3{font-family:var(--serif); font-size:20px; font-weight:700; color:var(--ink); margin-bottom:8px}
  .step p{font-size:14.5px}

  .times{margin-top:36px; text-align:center; font-size:15.5px; color:var(--mute)}
  .times strong{color:var(--ink)}

  /* MSP levers */
  .levers{display:grid; grid-template-columns:repeat(2,1fr); gap:18px 34px; margin-top:44px}
  @media(max-width:700px){ .levers{grid-template-columns:1fr} }
  .lever{display:flex; gap:16px; align-items:flex-start}
  .lever .dot{flex:none; width:38px; height:38px; border:1.5px solid var(--bronze); border-radius:50%; display:flex; align-items:center; justify-content:center; color:var(--bronze-l); font-size:16px}
  .lever h4{font-family:var(--serif); font-size:19px; color:var(--paper); font-weight:700; margin-bottom:4px}
  .lever p{font-size:14.5px; color:var(--dark-text)}

  /* pilot */
  .pilot-box{display:grid; grid-template-columns:1.2fr .8fr; gap:34px; align-items:start}
  @media(max-width:840px){ .pilot-box{grid-template-columns:1fr} }
  .pilot-cond{background:var(--ink); color:var(--dark-text); border:1px solid var(--bronze); border-radius:6px; padding:30px 28px}
  .pilot-cond h3{font-family:var(--serif); font-size:22px; color:var(--bronze-l); margin-bottom:16px}
  .pilot-cond li{margin:0 0 12px 20px; font-size:15px}

  /* FAQ */
  details{border-bottom:1px solid var(--hair); padding:20px 4px}
  details summary{cursor:pointer; font-family:var(--serif); font-weight:700; font-size:20px; color:var(--ink); list-style:none; display:flex; justify-content:space-between; gap:14px}
  details summary::after{content:'+'; color:var(--bronze); font-size:24px; line-height:1}
  details[open] summary::after{content:'\2013'}
  details p{margin-top:12px; color:var(--mute); font-size:15.5px; max-width:820px}

  /* CTA band */
  .cta-band{background:var(--ink); text-align:center; padding:90px 24px}
  .cta-band h2{font-family:var(--serif); font-weight:600; font-size:clamp(30px,4vw,46px); color:var(--paper); line-height:1.15}
  .cta-band h2 span{color:var(--bronze-l)}
  .cta-band p{color:var(--dark-mute); max-width:620px; margin:18px auto 32px}

  .contact-card{display:inline-flex; gap:0; align-items:stretch; margin:38px auto 0; border:1px solid var(--bronze); border-radius:6px; background:#2F2A24; overflow:hidden; flex-wrap:wrap; justify-content:center}
  .contact-card a{display:flex; flex-direction:column; gap:4px; padding:20px 42px; text-decoration:none; color:var(--paper)}
  .contact-card a + a{border-left:1px solid var(--dark-hair)}
  .contact-card .lbl{font-size:11px; font-weight:700; letter-spacing:.24em; text-transform:uppercase; color:var(--bronze-l)}
  .contact-card .val{font-family:var(--serif); font-size:22px; font-weight:600}
  .contact-card a:hover .val{color:var(--bronze-l)}
  @media(max-width:640px){ .contact-card{width:100%} .contact-card a{width:100%; padding:16px 20px} .contact-card a + a{border-left:none; border-top:1px solid var(--dark-hair)} }
  footer{background:#1E1B17; color:var(--dark-mute); padding:46px 0; font-size:13.5px}
  footer .cols{display:flex; justify-content:space-between; gap:28px; flex-wrap:wrap}
  footer .brand{font-family:var(--serif); letter-spacing:.14em; text-transform:uppercase; color:var(--paper); font-size:17px; margin-bottom:8px}
  footer a{color:var(--bronze-l); text-decoration:none}


  /* ---------- images ---------- */
  .feature{display:grid; grid-template-columns:1.05fr .95fr; gap:44px; align-items:center}
  @media(max-width:840px){ .feature{grid-template-columns:1fr} }
  .feature img{width:100%; height:auto; border-radius:6px; border:1px solid var(--hair); display:block}
  .dark .feature img{border-color:var(--dark-hair)}
  .banner{margin:0 0 44px; border-radius:6px; overflow:hidden; border:1px solid var(--dark-hair)}
  .banner img{width:100%; height:340px; object-fit:cover; display:block}
  @media(max-width:640px){ .banner img{height:220px} }
  .reveal{opacity:0; transform:translateY(18px); transition:opacity .6s ease, transform .6s ease}
  .reveal.in{opacity:1; transform:none}


  /* ---------- mobile refinements ---------- */
  html{-webkit-text-size-adjust:100%}
  .nav-toggle{display:none; background:none; border:1px solid var(--hair); border-radius:4px; font-size:20px; line-height:1; padding:7px 11px; color:var(--ink); cursor:pointer}
  @media(max-width:840px){
    .nav-toggle{display:block}
    .nav-links{display:none; position:absolute; top:66px; left:0; right:0; background:rgba(255,255,255,.98); border-bottom:1px solid var(--hair); flex-direction:column; align-items:stretch; padding:14px 24px 18px; gap:16px; box-shadow:0 12px 24px rgba(38,34,30,.08)}
    .nav-links.open{display:flex}
    .nav-links a{display:block}
    .nav-links .btn{text-align:center}
  }
  @media(max-width:640px){
    section{padding:56px 0}
    .sec-head{margin-bottom:36px}
    .hero-in{padding-top:56px}
    h1{line-height:1.15}
    .hero-sub{font-size:16.5px}
    .door{padding:26px 22px}
    .card{padding:22px 20px}
    .statement{padding:20px 18px; font-size:15px}
    .step{padding:20px 18px}
    .steps-2{grid-template-columns:1fr !important}
    .pilot-cond{padding:24px 20px}
    .cta-band{padding:64px 20px}
    .banner{margin-bottom:32px}
    footer .cols{flex-direction:column; gap:20px}
    .feature{gap:24px}
    .levers{gap:16px}
  }

  /* ---------- doors row alignment (subgrid) ---------- */
  @supports (grid-template-rows: subgrid) {
    @media (min-width: 761px) {
      .doors{grid-template-rows:auto auto 1fr auto}
      .door{display:grid; grid-template-rows:subgrid; grid-row:span 4; row-gap:0; align-items:start}
      .door p{margin-bottom:0}
      .door a{align-self:end}
    }
  }

  /* ---------- comuni serviti ---------- */
  .comuni-grid{list-style:none; display:flex; flex-wrap:wrap; gap:10px; justify-content:center; margin:0 auto 40px; max-width:940px}
  .comuni-grid li{background:var(--paper); border:1px solid var(--hair); border-radius:100px; padding:9px 18px; font-size:14.5px; font-weight:600; color:var(--ink2)}
  .upgrade{background:var(--ink); border:1px solid var(--bronze); border-radius:6px; padding:32px 34px; max-width:940px; margin:0 auto}
  .upgrade .up-title{font-family:var(--serif); font-size:26px; font-weight:700; color:var(--paper); margin-bottom:10px}
  .upgrade .up-text{color:var(--dark-text); font-size:15.5px; margin-bottom:22px; max-width:720px}
  .upgrade .btn-ghost{border-color:var(--bronze-l); color:var(--bronze-l)}
  .upgrade .btn-ghost:hover{background:var(--bronze-l); color:var(--ink)}
  @media(max-width:640px){
    .comuni-grid{gap:8px; margin-bottom:28px}
    .comuni-grid li{padding:7px 14px; font-size:13.5px}
    .upgrade{padding:24px 20px}
    .upgrade .up-title{font-size:22px}
    .upgrade .hero-cta{flex-direction:column}
    .upgrade .hero-cta .btn{width:100%; text-align:center}
  }
</style>
</head>
<body>
<slot />
<script is:inline>
  const obs = new IntersectionObserver((entries)=>{
    entries.forEach(e=>{ if(e.isIntersecting){ e.target.classList.add('in'); obs.unobserve(e.target);} });
  },{threshold:.12});
  document.querySelectorAll('.reveal').forEach(el=>obs.observe(el));

  const t = document.querySelector('.nav-toggle');
  const links = document.querySelector('.nav-links');
  if (t && links) {
    t.addEventListener('click', () => {
      const open = links.classList.toggle('open');
      t.setAttribute('aria-expanded', open);
    });
    links.querySelectorAll('a').forEach(a => a.addEventListener('click', () => {
      links.classList.remove('open'); t.setAttribute('aria-expanded', 'false');
    }));
  }

</script>
</body>
</html>
